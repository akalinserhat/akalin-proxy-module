{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "allowJs": true,
    "paths": {
      "@microsoft/signalr": [
        "../webakus/Webakus.UI/node_modules/@microsoft/signalr",
        "../webakus/node_modules/@microsoft/signalr"
      ],
      "react": [
        "../think-port-api/frontend/node_modules/@types/react",
        "../akalin-ui/node_modules/@types/react"
      ],
      "react/*": [
        "../think-port-api/frontend/node_modules/@types/react/*",
        "../akalin-ui/node_modules/@types/react/*"
      ],
      "react-dom": [
        "../think-port-api/frontend/node_modules/@types/react-dom",
        "../akalin-ui/node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../think-port-api/frontend/node_modules/@types/react-dom/*",
        "../akalin-ui/node_modules/@types/react-dom/*"
      ],
      "react-router-dom": [
        "../think-port-api/frontend/node_modules/react-router-dom",
        "../akalin-ui/node_modules/react-router-dom",
        "../webakus/node_modules/react-router-dom"
      ],
      "react-i18next": [
        "../think-port-api/frontend/node_modules/react-i18next",
        "../webakus/node_modules/react-i18next"
      ],
      "i18next": [
        "../think-port-api/frontend/node_modules/i18next",
        "../webakus/node_modules/i18next"
      ],
      "react-hot-toast": [
        "../think-port-api/frontend/node_modules/react-hot-toast",
        "../webakus/node_modules/react-hot-toast"
      ],
      "lucide-react": [
        "../think-port-api/frontend/node_modules/lucide-react",
        "../akalin-ui/node_modules/lucide-react",
        "../webakus/node_modules/lucide-react"
      ],
      "@akalin/ui": ["../akalin-ui/src/index.ts"],
      "@akalin/ui/*": ["../akalin-ui/src/*"],
      "@akalin/module_core": ["../akalin-module-core/src/index.ts"],
      "@akalin/module_core/*": ["../akalin-module-core/src/*"],
      "@akalin/global_search_module": ["../akalin-global-search-module/src/index.ts"],
      "@akalin/global_search_module/*": ["../akalin-global-search-module/src/*"]
    }
  },
  "include": ["src"]
}
